            },
            {
              "id": "demo-message",
              "name": "demo_message",
              "type": "string",
              "value": "Hi! This is a test message sent from n8n using the Aloware community node."
            }
          ]
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Demo Input",
