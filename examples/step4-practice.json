      "typeVersion": 3.4,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "lookupByPhone",
        "phone_number": "={{ $json.demo_phone }}",
        "requestOptions": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Look Up Contact",
