{
	"name": "n8n-nodes-aloware",
	"version": "0.2.1",
	"description": "n8n community node for Aloware \u2014 trigger on call, SMS and AloAi events; send SMS/MMS, place two-legged calls, manage contacts, sequences and power dialer lists via the Aloware API.",
	"license": "MIT",
	"homepage": "https://github.com/aloware/n8n-nodes-aloware",
	"bugs": {
		"url": "https://github.com/aloware/n8n-nodes-aloware/issues"
	},
	"keywords": [
		"aloware",
		"calls",
		"contact-center",
		"cpaas",
		"n8n-community-node-package",
		"sms",
		"trigger",
		"two-legged-call",
		"voice",
		"webhook"
	],
	"author": {
		"name": "Maxim Dudnik",
		"email": "maxim@aloware.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/aloware/n8n-nodes-aloware"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/credentials",
		"dist/nodes"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AlowareApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Aloware/Aloware.node.js",
			"dist/nodes/AlowareTrigger/AlowareTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.23.0",
		"eslint": "9.39.4",
		"prettier": "3.8.1",
		"release-it": "19.2.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
