{
	"name": "n8n-nodes-aloware",
	"version": "0.1.0",
	"description": "n8n community node for Aloware — send SMS/MMS, manage contacts, enroll into sequences and manage power dialer lists via the Aloware API.",
	"license": "MIT",
	"homepage": "https://github.com/aloware/n8n-nodes-aloware",
	"bugs": {
		"url": "https://github.com/aloware/n8n-nodes-aloware/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"aloware",
		"sms",
		"cpaas",
		"contact-center"
	],
	"author": {
		"name": "Maxim Dudnik",
		"email": "maxim@aloware.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aloware/n8n-nodes-aloware.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/credentials",
		"dist/nodes"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AlowareApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Aloware/Aloware.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.23.0",
		"eslint": "9.39.4",
		"prettier": "3.8.1",
		"release-it": "19.2.4",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": ">=1.0.0"
	}
}
